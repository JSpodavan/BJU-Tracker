# Server
PORT=5000

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=your_username
PG_PASSWORD=your_password
PG_DATABASE=your_database

# JWT
JWT_SECRET=your_secret_key

# Edamam API (для поиска продуктов)
EDAMAM_ID=your_edamam_app_id
EDAMAM_KEY=your_edamam_app_key

# Email для отправки писем для восстановления пароля
# Пароль от приложения можно получить в настройках безопасности Google аккаунта (Если вы используете google почту)
EMAIL=your_email@gmail.com
EMAIL_PASS=your_app_password
